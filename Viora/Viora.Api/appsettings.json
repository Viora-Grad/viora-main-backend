{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "BasePath": "./Media",
    "MaxFileSizeBytes": 10485760
  },

  "OnBoarding": {
    "DaysTillExpiry": 30,
    "CoolDownPeriod": "30.00:00:00"
  },

  "Suspension": {
    "DeletionSpan": "30.00:00:00"
  },

  "Scheduling": {
    "BatchSize": 50,
    "MaxAttempts": 5,
    "PollInterval": "00:00:30"
  }
}
