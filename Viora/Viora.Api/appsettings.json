{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "BasePath": "./Media",
    "MaxFileSizeBytes": 10485760
  },

  "OnBoarding": {
    "DaysTillExpiry": 30,
    "CoolDownPeriod": "30.00:00:00"
  },

  "Suspension": {
    "DeletionSpan": "30.00:00:00"
  },

  "Scheduling": {
    "BatchSize": 50,
    "MaxAttempts": 5,
    "PollInterval": "00:00:30"
  },

  "Service": {
    "SlotSizeInMinutes": 10,
    "MinimumDurationInMinutes": 10,
    "MaximumDurationInMinutes": 180,
    "MaxGallerySize": 8
  },

  "Email": {
    "SmtpDomain": "smtp.gmail.com",
    "DomainPort": 587,
    "Email": "", // over-riden by env in runtime
    "Password": ""
  },

  "AI": {
    "ViviHealth": {
      "HealthModel": "gemini-2.5-flash",
      "HealthApiKey": "", // over-riden by env in runtime
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models/"
    },

    "ViviClient": {
      "ClientModel": "gemini-2.5-flash",
      "ClientApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models/"
    },

    "ViviMarketing": {
      "MarketingModel": "gemini-2.5-flash",
      "MarketingApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/models/"
    }
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://localhost:4200",
    ]
}