{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/viora-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",

  "Storage": {
    "BasePath": "./Media",
    "MaxFileSizeBytes": 10485760
  },

  "OnBoarding": {
    "DaysTillExpiry": 30,
    "CoolDownPeriod": "30.00:00:00"
  },

  "Suspension": {
    "DeletionSpan": "30.00:00:00"
  },

  "Scheduling": {
    "BatchSize": 50,
    "MaxAttempts": 5,
    "PollInterval": "00:00:30"
  },

  "Service": {
    "SlotSizeInMinutes": 10,
    "MinimumDurationInMinutes": 10,
    "MaximumDurationInMinutes": 180,
    "MaxGallerySize": 8
  },

  "Email": {
    "SmtpDomain": "smtp.gmail.com",
    "DomainPort": 587,
    "Email": "", // over-riden by env in runtime
  },

  "Admins": { "Emails":[ "teamcomplex.grad@gmail.com" ] },

  "Branch": {
    "MaximumGallerySize" :  15
  },

  "Wallet": {
    "PromiseGraceMinutes": 1440
  },

  "AiRag": {
    "Groq": {
      "MaxTokens": 2048,
      "Temperature": 0.3
    },
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334
    },
    "Onnx": {
      "ModelPath": "Models/all-MiniLM-L6-V2/model.onnx",
      "VocabPath": "Models/all-MiniLM-L6-V2/vocab.txt",
      "MaxLength": 256
    },
    "KnowledgeBase": {
      "FilePath": "Knowledge/viora_knowledge_base.md"
    },
    "SpecialtyBase": {
      "FilePath": "Knowledge/specialty_inquiries.json"
    }
  },

  "AllowedOrigins": [
    "http://localhost:4200",
    "https://localhost:4200"
    ]
}